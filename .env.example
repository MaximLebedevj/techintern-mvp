# ============================================================================
# TechIntern — корневой .env для docker-compose.
# Скопируйте в `.env`:  cp .env.example .env
# Для локального запуска значений по умолчанию достаточно.
# ============================================================================

# --- Порты на хосте ---
WEB_PORT=8080         # http://localhost:8080  — приложение
API_PORT=4000         # http://localhost:4000  — API напрямую (и /docs)
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL ---
POSTGRES_USER=techintern
POSTGRES_PASSWORD=techintern
POSTGRES_DB=techintern

# --- JWT (для прода сгенерируйте: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Cookie / публичные URL ---
# COOKIE_SECURE=true  — ТОЛЬКО если приложение работает по HTTPS (на VPS).
COOKIE_SECURE=false
# В Docker фронт и API на одном origin (web-nginx проксирует /api):
APP_PUBLIC_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080

# --- OAuth2 (необязательно; кнопки появятся, только если заданы ключи) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
