# ============================================================================
# apps/api/.env — для локального запуска без Docker.
# Скопируйте в `.env` и при необходимости отредактируйте.
# ============================================================================

NODE_ENV=development
API_PORT=4000

# Подключения (локальные сервисы)
DATABASE_URL=postgresql://techintern:techintern@localhost:5432/techintern?schema=public
REDIS_URL=redis://localhost:6379

# JWT — сгенерируйте: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Публичные URL
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# OAuth2 (необязательно для базового запуска)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
